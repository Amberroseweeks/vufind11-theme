
<div class="footer footer-container">
  <?php foreach ($this->menu ?? [] as $name => $group): ?>
    <div class="footer-column">
      <?php $this->slot($name)->start(); ?>
        <ul <?=$attributes?>
          <?php if (!empty($item['id'])): ?>
              <?php
              $id = $item['id'];

              $class = match ($id) {
                  'social-links' => 'social',
                  default => 'solid',
              };
              ?>
          <?php endif; ?>
        class="list-inline text-start">
          <?php foreach ($group['MenuItems'] as $item): ?>
            <?php
              $attributes = $this->htmlAttributes($item['attributes'] ?? []);
              $attributes['href'] = isset($item['route'])
                ? $this->url($item['route'], $item['routeParams'] ?? [])
                : $item['url'];
            ?>
<li>
  <a <?=$attributes?>>
    <?php if (!empty($item['icon'])): ?>
            <?php
$iconType = $item['iconType'] ?? 'solid';

$iconClass = match ($iconType) {
    'brands' => 'fa-brands',
    'regular' => 'fa-regular',
    default => 'fa-solid',
};
?>

        <i class="<?= $this->escapeHtmlAttr($iconClass) ?>
                <?= $this->escapeHtmlAttr('fa-' . $item['icon']) ?>"
        aria-hidden="true"></i>
    <?php endif; ?>

    <?php if (empty($item['iconOnly'])): ?>
      <span><?=$this->transEsc($item['label'])?></span>
    <?php else: ?>
      <span class="visually-hidden"><?=$this->transEsc($item['label'])?></span>
    <?php endif; ?>
  </a>
</li>          <?php endforeach; ?>
        </ul>
      <?=$this->slot($name)->end(); ?>
    </div>
  <?php endforeach; ?>
</div>
